@model Ocean_Analyzer_Fresh.Models.OceanShipmentDashboardViewModel
@using System.Data

@{
    ViewBag.Title = "Executive P&L Dashboard | Gillship & Gillespie-Munro";
    Layout = null;
    decimal profitMargin = Model.TotalPaidRevenue > 0 ? (Model.TotalGrossProfit / Model.TotalPaidRevenue) * 100 : 0;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewBag.Title</title>

    <!-- Fonts & Icons -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://api.fontshare.com/v2/css?f[]=general-sans@500,600,700&f[]=satoshi@400,500,700,900&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="@Url.Content("~/Content/date-filter.css")">
    <!-- DataTables CSS -->
    <link href="https://cdn.datatables.net/1.13.6/css/dataTables.bootstrap5.min.css" rel="stylesheet">

    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.4/dist/chart.umd.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chartjs-plugin-datalabels@2.2.0"></script>

    <!-- EMBEDDED STYLES WITH SIDEBAR COLLAPSE TRANSITION -->
    <style>
        :root, [data-theme='light'] {
            --color-bg: #eef2f7;
            --color-surface: #ffffff;
            --color-surface-2: #f7f9fc;
            --color-surface-offset: #e8edf4;
            --color-border: #d8e0ea;
            --color-divider: #e3e9f1;
            --color-text: #0f1a2b;
            --color-text-muted: #5b6b81;
            --color-text-faint: #97a5b8;
            --color-primary: #0e7490;
            --color-primary-highlight: #d3ebf1;
            --color-secondary: #2c4a8a;
            --color-success: #157f4b;
            --color-error: #b3261e;
            --color-warning: #a35a09;
            --radius-md: 0.625rem;
            --radius-lg: 0.875rem;
            --radius-full: 9999px;
            --shadow-sm: 0 1px 2px rgba(0,0,0,0.06);
            --shadow-md: 0 4px 14px rgba(0,0,0,0.08);
            --font-display: 'General Sans', sans-serif;
            --font-body: 'Satoshi', sans-serif;
        }

        body {
            background-color: var(--color-bg);
            font-family: var(--font-body);
            color: var(--color-text);
            margin: 0;
            padding: 0;
            overflow-x: hidden;
        }

        /* Dashboard Grid Layout with Smooth Transition */
        .dashboard {
            display: grid;
            grid-template-columns: 240px 1fr;
            height: 100vh;
            transition: grid-template-columns 0.3s cubic-bezier(0.16, 1, 0.3, 1);
        }

            .dashboard.sidebar-collapsed {
                grid-template-columns: 0px 1fr;
            }

        .sidebar {
            background: var(--color-surface);
            border-right: 1px solid var(--color-border);
            display: flex;
            flex-direction: column;
            padding: 1.25rem 1rem;
            gap: 1.5rem;
            overflow-y: auto;
            overflow-x: hidden;
            white-space: nowrap;
            transition: opacity 0.2s ease, padding 0.3s ease;
        }

        .dashboard.sidebar-collapsed .sidebar {
            opacity: 0;
            padding: 0;
            pointer-events: none;
            border-right: none;
        }

        .brand {
            display: flex;
            align-items: center;
            gap: 0.75rem;
            font-family: var(--font-display);
            font-weight: 700;
            font-size: 0.9rem;
        }

            .brand svg {
                width: 32px;
                height: 32px;
                color: var(--color-primary);
                flex-shrink: 0;
            }

            .brand span {
                display: block;
                font-size: 0.75rem;
                color: var(--color-text-muted);
                font-weight: 500;
            }

        .nav-group {
            display: flex;
            flex-direction: column;
            gap: 0.25rem;
        }

        .nav-label {
            font-size: 0.7rem;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            color: var(--color-text-faint);
            font-weight: 700;
            padding: 0 0.5rem;
            margin-bottom: 0.25rem;
        }

        .nav-link {
            display: flex;
            align-items: center;
            gap: 0.75rem;
            padding: 0.5rem 0.75rem;
            border-radius: var(--radius-md);
            font-size: 0.85rem;
            color: var(--color-text-muted);
            font-weight: 500;
            text-decoration: none;
            border: none;
            background: none;
            width: 100%;
            text-align: left;
            cursor: pointer;
            transition: all 0.2s ease;
        }

            .nav-link:hover, .nav-link.active {
                background: var(--color-primary-highlight);
                color: var(--color-primary);
            }

        .main-col {
            display: flex;
            flex-direction: column;
            height: 100vh;
            overflow: hidden;
            min-width: 0;
        }

        .topbar {
            background: var(--color-surface);
            border-bottom: 1px solid var(--color-border);
            padding: 1rem 1.5rem;
            display: flex;
            flex-direction: column;
            gap: 0.75rem;
            flex-shrink: 0;
        }

        .topbar-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .topbar-title {
            font-size: 1.25rem;
            font-weight: 700;
            font-family: var(--font-display);
        }

        .sidebar-toggle-btn {
            background: var(--color-surface-offset);
            border: 1px solid var(--color-border);
            color: var(--color-text);
            border-radius: 8px;
            padding: 6px 10px;
            font-size: 14px;
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            transition: all 0.2s;
        }

            .sidebar-toggle-btn:hover {
                background: var(--color-primary-highlight);
                color: var(--color-primary);
            }

        .filters-row {
            display: flex;
            align-items: flex-end;
            gap: 0.75rem;
            flex-wrap: wrap;
        }

        .filter-field {
            display: flex;
            flex-direction: column;
            gap: 2px;
        }

            .filter-field label {
                font-size: 10px;
                text-transform: uppercase;
                letter-spacing: 0.05em;
                color: #112b4f;
                font-weight: 700;
            }

        .form-select, .form-control {
            border-radius: 8px;
            border-color: var(--color-border);
            font-size: 12px;
            padding: 6px 10px;
        }

        .main-scroll {
            flex: 1;
            overflow-y: auto;
            padding: 1.5rem;
            display: flex;
            flex-direction: column;
            gap: 2rem;
        }

        .section {
            display: flex;
            flex-direction: column;
            gap: 1rem;
        }

        .section-title {
            font-size: 1.15rem;
            font-weight: 700;
            font-family: var(--font-display);
        }

        .kpi-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 1rem;
        }

        .kpi-card {
            background: var(--color-surface);
            border: 1px solid var(--color-border);
            border-radius: var(--radius-lg);
            padding: 1.25rem;
            display: flex;
            flex-direction: column;
            gap: 0.5rem;
            box-shadow: var(--shadow-sm);
        }

        .kpi-label {
            font-size: 0.75rem;
            color: #091c36;
            font-weight: 600;
            display: flex;
            align-items: center;
            gap: 0.35rem;
        }

        .kpi-value {
            font-size: 1.5rem;
            font-weight: 700;
            font-family: var(--font-display);
        }

        .grid-4 {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 1rem;
        }

        @@media (max-width: 1400px) {
            .grid-4 {
                grid-template-columns: repeat(2, 1fr);
            }
        }

        @@media (max-width: 768px) {
            .grid-4 {
                grid-template-columns: 1fr;
            }
        }

        .panel {
            background: var(--color-surface);
            border: 1px solid var(--color-border);
            border-radius: var(--radius-lg);
            padding: 1.25rem;
            box-shadow: var(--shadow-sm);
            display: flex;
            flex-direction: column;
            gap: 1rem;
            height: 100%;
        }

        .panel-title {
            font-size: 0.9rem;
            font-weight: 700;
            font-family: var(--font-display);
        }

        .chart-wrap {
            position: relative;
            height: 230px;
        }

        .data-table {
            width: 100%;
            font-size: 0.8rem;
            border-collapse: collapse;
        }

            .data-table th, .data-table td {
                padding: 0.65rem 0.75rem;
                border-bottom: 1px solid var(--color-divider);
                text-align: left;
                white-space: nowrap;
            }

            .data-table th {
                background: var(--color-surface-2);
                font-weight: 700;
                color: var(--color-text-muted);
                font-size: 0.7rem;
                text-transform: uppercase;
            }

            .data-table tr:hover td {
                background: var(--color-surface-offset);
            }

        .tnum {
            font-variant-numeric: tabular-nums;
        }

        canvas {
            cursor: pointer;
        }
    </style>
</head>
<body>

    <div class="dashboard" id="dashboardLayout">
        <!-- SIDEBAR NAVIGATION -->
        <aside class="sidebar" aria-label="Primary navigation">
            <div class="brand">
                <svg viewBox="0 0 32 32" fill="none"><rect width="32" height="32" rx="8" fill="currentColor" /><path d="M6 20.5l6-11 6 11M18 20.5l4-7.5 4 7.5" stroke="white" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round" /></svg>
                <div>Performance Dashboard <span>Load Access BI</span></div>
            </div>

            <nav class="nav-group">
                <div class="nav-label">Modules</div>
                <a href="@Url.Action("Ocean_Dashboard", "Dashboard")" class="nav-link active"><i class="bi bi-grid-1x2-fill"></i> Executive Overview</a>
                <a href="@Url.Action("ProfitAnalysis", "Dashboard")" class="nav-link"><i class="bi bi-graph-up-arrow"></i> Profit &amp; Loss P&amp;L</a>
                <a href="@Url.Action("UserPerformance", "Dashboard")" class="nav-link"><i class="bi bi-person-badge-fill"></i> User Productivity</a>
                <a href="@Url.Action("SalesPersonPerformance", "Dashboard")" class="nav-link"><i class="bi bi-people-fill"></i> Sales Performance</a>
                <a href="@Url.Action("StationTradeLane", "Dashboard")" class="nav-link"><i class="bi bi-compass-fill"></i> Company Trade Lanes</a>
                <a href="@Url.Action("CbmAnalysis", "Dashboard")" class="nav-link"><i class="bi bi-box-seam-fill"></i> CBM Volume</a>
                <a href="@Url.Action("Trends", "Dashboard")" class="nav-link"><i class="bi bi-activity"></i> Trends</a>
            </nav>
            @Html.Partial("_DateRangeLabel", Model)
        </aside>

        <!-- MAIN VIEW AREA -->
        <div class="main-col">
            <header class="topbar">
                <div class="topbar-header">
                    <div class="d-flex align-items-center gap-3">
                        <button type="button" id="sidebarToggleBtn" class="sidebar-toggle-btn" title="Expand/Collapse Sidebar">
                            <i class="bi bi-layout-sidebar"></i>
                        </button>
                        <div class="topbar-title">Ocean Freight Intelligence Hub</div>
                    </div>
                    <!-- UPLOAD EXCEL BUTTON TRIGGER -->
                    <button type="button" class="btn btn-success btn-sm d-flex align-items-center gap-2" data-bs-toggle="modal" data-bs-target="#uploadExcelModal">
                        <i class="bi bi-file-earmark-arrow-up-fill"></i> Upload Excel Data
                    </button>
                </div>

                <!-- ADVANCED FILTERS WITH ETS/ETA/POSTED CONTROLS -->
                @using (Html.BeginForm("Ocean_Dashboard", "Dashboard", FormMethod.Get, new { @class = "filters-row" }))
                {
                    @Html.Partial("_DateFilter", Model)
                    <div class="filter-field">
                        <label>Companies</label>
                        @Html.DropDownList("selectedStation", new SelectList(Model.AvailableStations, Model.SelectedStation), "-- All Companies --", new { @class = "form-select form-select-sm", id = "selectedStation" })
                    </div>
                    <div class="filter-field">
                        <label>Customer Account</label>
                        @Html.DropDownList("selectedCustomer", new SelectList(Model.AvailableCustomers, Model.SelectedCustomer), "-- All Customers --", new { @class = "form-select form-select-sm", id = "selectedCustomer" })
                    </div>
                    <div class="filter-field">
                        <label>File Status</label>
                        @Html.DropDownList("selectedFileStatus", new SelectList(Model.AvailableFileStatuses, Model.SelectedFileStatus), "-- All Statuses --", new { @class = "form-select form-select-sm" })
                    </div>
                    <div class="filter-field">
                        <label>Created By</label>
                        @Html.DropDownList("selectedCreatedBy", new SelectList(Model.AvailableCreatedBy, Model.SelectedCreatedBy), "-- All Users --", new { @class = "form-select form-select-sm" })
                    </div>
                    <div class="filter-field">
                        <label>Salesperson</label>
                        @Html.DropDownList("selectedSalesPerson", new SelectList(Model.AvailableSalesPersons, Model.SelectedSalesPerson), "-- All Sales Persons --", new { @class = "form-select form-select-sm", id = "selectedSalesPerson" })
                    </div>
                    <div class="filter-actions">
                        <button type="submit" class="btn btn-applied btn-sm px-3 py-1">Apply Filters</button>
                    </div>
                }
            </header>

            <main class="main-scroll" id="mainScroll">
                <!-- NOTIFICATION ALERTS -->
                @if (TempData["UploadMessage"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show" role="alert">
                        <i class="bi bi-check-circle-fill me-2"></i> @TempData["UploadMessage"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }
                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }

                <!-- OVERVIEW KPIS -->
                <section class="section">
                    <div class="section-title">Performance Metrics</div>
                    <div class="kpi-grid">
                        <div class="kpi-card">
                            <div class="kpi-label"><i class="bi bi-ship"></i> Total Shipments</div>
                            <div class="kpi-value tnum">@Model.TotalShipments.ToString("N0")</div>
                        </div>
                        <div class="kpi-card">
                            <div class="kpi-label"><i class="bi bi-wallet2"></i> Total Cost Outlay</div>
                            <div class="kpi-value tnum text-danger">$@Model.TotalCost.ToString("N2")</div>
                        </div>
                        <div class="kpi-card">
                            <div class="kpi-label"><i class="bi bi-cash-stack"></i> Invoiced Revenue</div>
                            <div class="kpi-value tnum text-success">$@Model.TotalPaidRevenue.ToString("N2")</div>
                        </div>
                        <div class="kpi-card">
                            <div class="kpi-label"><i class="bi bi-star-fill"></i> Net Gross Profit</div>
                            <div class="kpi-value tnum text-warning">$@Model.TotalGrossProfit.ToString("N2") (@profitMargin.ToString("N1")%)</div>
                        </div>
                    </div>
                </section>

                <!-- 4-PANEL GRAPH SECTION -->
                <section class="section">
                    <div class="section-title">Operational &amp; Financial Visualizations</div>
                    <div class="grid-4">
                        <div class="panel">
                            <div class="panel-title"><i class="bi bi-graph-up text-primary me-2"></i> Companies Volume</div>
                            <div class="chart-wrap"><canvas id="stationBarChart"></canvas></div>
                        </div>
                        <div class="panel">
                            <div class="panel-title"><i class="bi bi-pie-chart-fill text-success me-2"></i> User Workload</div>
                            <div class="chart-wrap"><canvas id="userBarChart"></canvas></div>
                        </div>
                        <div class="panel">
                            <div class="panel-title"><i class="bi bi-award-fill text-info me-2"></i> Salesperson Amount</div>
                            <div class="chart-wrap"><canvas id="salesPersonBarChart"></canvas></div>
                        </div>
                        <div class="panel">
                            <div class="panel-title"><i class="bi bi-pie-chart-fill text-warning me-2"></i> Customer Share</div>
                            <div class="chart-wrap"><canvas id="customerDoughnutChart"></canvas></div>
                        </div>
                    </div>
                </section>

                <!-- TRANSACTION LEDGER TABLE -->
                <section class="section">
                    <div class="panel" style="height: auto;">
                        <div class="panel-title">Shipment Transaction Ledger (@Model.ShipmentData.Rows.Count Records Loaded)</div>
                        <div style="overflow-x: auto;">
                            <table class="data-table" id="shipmentTable">
                                <thead>
                                    <tr>
                                        @foreach (DataColumn col in Model.ShipmentData.Columns)
                                        {
                                            <th>@col.ColumnName</th>
                                        }
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (DataRow row in Model.ShipmentData.Rows)
                                    {
                                        <tr>
                                            @foreach (var item in row.ItemArray)
                                            {
                                                <td>@item.ToString()</td>
                                            }
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </section>
            </main>
        </div>
    </div>

    <!-- EXCEL UPLOAD MODAL -->
    <div class="modal fade" id="uploadExcelModal" tabindex="-1" aria-labelledby="uploadExcelModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg" style="border-radius: var(--radius-lg);">
                @using (Html.BeginForm("UploadNewRevenueAnalyzer", "Dashboard", FormMethod.Post, new { enctype = "multipart/form-data" }))
                {
                    <div class="modal-header bg-light" style="border-top-left-radius: var(--radius-lg); border-top-right-radius: var(--radius-lg);">
                        <h5 class="modal-title fw-bold text-dark fs-6" id="uploadExcelModalLabel">
                            <i class="bi bi-file-earmark-spreadsheet-fill text-success me-2"></i> Upload CargoWise BI Data Files
                        </h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body p-4 d-flex flex-column gap-3">
                        <div class="form-group">
                            <label class="form-label small fw-bold text-uppercase text-muted">Summary Excel File (.xlsx)</label>
                            <input type="file" name="summaryFile" class="form-control form-control-sm" accept=".xlsx, .xls" required />
                        </div>
                        <div class="form-group">
                            <label class="form-label small fw-bold text-uppercase text-muted">Detail Dates Excel File (.xlsx)</label>
                            <input type="file" name="detailFile" class="form-control form-control-sm" accept=".xlsx, .xls" required />
                        </div>
                        <div class="alert alert-warning small mb-0" role="alert">
                            <i class="bi bi-info-circle-fill me-1"></i> Uploading new files will automatically truncate and refresh the live analytical dataset.
                        </div>
                    </div>
                    <div class="modal-footer bg-light" style="border-bottom-left-radius: var(--radius-lg); border-bottom-right-radius: var(--radius-lg);">
                        <button type="button" class="btn btn-secondary btn-sm px-3" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-success btn-sm px-4">Upload &amp; Synchronize</button>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Scripts -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>
    <script src="@Url.Content("~/Scripts/date-filter.js")"></script>
    <script>
    document.addEventListener("DOMContentLoaded", function () {
        Chart.register(ChartDataLabels);

        // Sidebar Toggle Handler with Chart Resize Trigger
        const toggleBtn = document.getElementById('sidebarToggleBtn');
        const dashboardLayout = document.getElementById('dashboardLayout');
        if (toggleBtn && dashboardLayout) {
            toggleBtn.addEventListener('click', function () {
                dashboardLayout.classList.toggle('sidebar-collapsed');
                setTimeout(function () {
                    window.dispatchEvent(new Event('resize'));
                }, 300);
            });
        }

        // Dynamic Cascading Dropdown Logic (Companies -> Customers & Salespersons)
        $('#selectedStation').change(function () {
            var selectedStation = $(this).val();
            var customerDropdown = $('#selectedCustomer');
            var salesPersonDropdown = $('#selectedSalesPerson');

            customerDropdown.empty();
            customerDropdown.append($('<option></option>').val('').text('-- All Customers --'));

            salesPersonDropdown.empty();
            salesPersonDropdown.append($('<option></option>').val('').text('-- All Sales Persons --'));

            var isAllSelected = !selectedStation || selectedStation === '-- All Companies --' || selectedStation === '-- All Stations --';

            // 1. Fetch Customers via AJAX
            $.ajax({
                url: '@Url.Action("GetCustomersByStation", "Dashboard")',
                type: 'GET',
                data: { station: isAllSelected ? '' : selectedStation },
                success: function (customers) {
                    $.each(customers, function (i, customer) {
                        customerDropdown.append($('<option></option>').val(customer).text(customer));
                    });
                },
                error: function (xhr, status, error) {
                    console.error("Failed to fetch customers: " + error);
                }
            });

            // 2. Fetch Salespersons via AJAX
            $.ajax({
                url: '@Url.Action("GetSalesPersonsByStation", "Dashboard")',
                type: 'GET',
                data: { station: isAllSelected ? '' : selectedStation },
                success: function (salesPersons) {
                    $.each(salesPersons, function (i, sp) {
                        salesPersonDropdown.append($('<option></option>').val(sp).text(sp));
                    });
                },
                error: function (xhr, status, error) {
                    console.error("Failed to fetch salespersons: " + error);
                }
            });
        });

        function getActiveDateParams() {
            const fromDateElem = document.querySelector('input[name="fromDate"]');
            const toDateElem = document.querySelector('input[name="toDate"]');
            const dateTypeElem = document.querySelector('input[name="dateType"]:checked');

            const fromDate = fromDateElem ? fromDateElem.value : '';
            const toDate = toDateElem ? toDateElem.value : '';
            const dateType = dateTypeElem ? dateTypeElem.value : 'ets';

            return `&fromDate=${encodeURIComponent(fromDate)}&toDate=${encodeURIComponent(toDate)}&dateType=${encodeURIComponent(dateType)}`;
        }

        // 1. Horizontal Bar Chart for Companies (Volume)
        const stationLabels = @Html.Raw(Json.Encode(Model.ShipmentsByStation.Keys.ToArray()));
        const stationCounts = @Html.Raw(Json.Encode(Model.ShipmentsByStation.Values.ToArray()));

        new Chart(document.getElementById('stationBarChart').getContext('2d'), {
            type: 'bar',
            data: {
                labels: stationLabels,
                datasets: [{
                    label: 'Shipment Volume',
                    data: stationCounts,
                    backgroundColor: '#0e7490',
                    borderRadius: 6
                }]
            },
            options: {
                indexAxis: 'y',
                responsive: true,
                maintainAspectRatio: false,
                layout: { padding: { right: 25 } },
                plugins: {
                    legend: { display: false },
                    datalabels: {
                        anchor: 'end',
                        align: 'right',
                        font: { size: 10, weight: 'bold' },
                        color: '#1e293b'
                    }
                },
                scales: {
                    x: { beginAtZero: true, grid: { color: '#f1f5f9' }, grace: '15%' },
                    y: { grid: { display: false }, ticks: { font: { size: 10 } } }
                },
                onClick: function (event, elements) {
                    if (elements.length > 0) {
                        const index = elements[0].index;
                        const stationName = stationLabels[index];
                        window.location.href = '@Url.Action("StationTradeLane", "Dashboard")?selectedStation=' + encodeURIComponent(stationName) + getActiveDateParams();
                    }
                }
            }
        });

        // 2. User Workload Pie Chart
        const userLabels = @Html.Raw(Json.Encode(Model.ShipmentsByUser.Keys.ToArray()));
        const userCounts = @Html.Raw(Json.Encode(Model.ShipmentsByUser.Values.ToArray()));
        new Chart(document.getElementById('userBarChart').getContext('2d'), {
            type: 'pie',
            data: {
                labels: userLabels,
                datasets: [{
                    data: userCounts,
                    backgroundColor: ['#10b981', '#0e7490', '#f59e0b', '#ef4444', '#8b5cf6', '#14b8a6'],
                    borderWidth: 0
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { position: 'bottom', labels: { boxWidth: 8, font: { size: 9 } } },
                    datalabels: {
                        color: '#fff',
                        font: { weight: 'bold', size: 10 },
                        formatter: (value) => value > 0 ? value : ''
                    }
                },
                onClick: function (event, elements) {
                    if (elements.length > 0) {
                        const index = elements[0].index;
                        const userName = userLabels[index];
                        window.location.href = '@Url.Action("UserPerformance", "Dashboard")?selectedCreatedBy=' + encodeURIComponent(userName) + getActiveDateParams();
                    }
                }
            }
        });

        // 3. Salesperson Amount Bar Chart
        const salesLabels = @Html.Raw(Json.Encode(Model.ShipmentsBySalesPerson.Keys.ToArray()));
        const salesCounts = @Html.Raw(Json.Encode(Model.ShipmentsBySalesPerson.Values.ToArray()));
        const maxSalesVal = salesCounts.length > 0 ? Math.max(...salesCounts) : 100;

        new Chart(document.getElementById('salesPersonBarChart').getContext('2d'), {
            type: 'bar',
            data: {
                labels: salesLabels,
                datasets: [{
                    label: 'Revenue Amount ($)',
                    data: salesCounts,
                    backgroundColor: '#06b6d4',
                    borderRadius: 6
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                layout: { padding: { top: 25 } },
                plugins: {
                    legend: { display: false },
                    datalabels: {
                        anchor: 'end',
                        align: 'top',
                        offset: 2,
                        font: { size: 9, weight: 'bold' },
                        color: '#1e293b',
                        formatter: (value) => '$' + Number(value).toLocaleString('en-US', {maximumFractionDigits: 0})
                    }
                },
                scales: {
                    y: {
                        beginAtZero: true,
                        grid: { color: '#f1f5f9' },
                        suggestedMax: maxSalesVal * 1.25
                    },
                    x: {
                        grid: { display: false },
                        ticks: { font: { size: 9 }, maxRotation: 20, minRotation: 20 }
                    }
                },
                onClick: function (event, elements) {
                    if (elements.length > 0) {
                        const index = elements[0].index;
                        const salesPerson = salesLabels[index];
                        window.location.href = '@Url.Action("SalesPersonPerformance", "Dashboard")?selectedSalesPerson=' + encodeURIComponent(salesPerson) + getActiveDateParams();
                    }
                }
            }
        });

        // 4. Customer Share Doughnut Chart
        const custLabels = @Html.Raw(Json.Encode(Model.TopCustomers.Keys.ToArray()));
        const custCounts = @Html.Raw(Json.Encode(Model.TopCustomers.Values.ToArray()));
        new Chart(document.getElementById('customerDoughnutChart').getContext('2d'), {
            type: 'doughnut',
            data: {
                labels: custLabels,
                datasets: [{
                    data: custCounts,
                    backgroundColor: ['#f59e0b', '#0e7490', '#10b981', '#ef4444', '#8b5cf6', '#14b8a6'],
                    borderWidth: 0
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { position: 'bottom', labels: { boxWidth: 8, font: { size: 9 } } },
                    datalabels: {
                        color: '#fff',
                        font: { weight: 'bold', size: 9 },
                        formatter: (value) => value > 0 ? '$' + (value/1000).toFixed(0) + 'k' : ''
                    }
                },
                onClick: function (event, elements) {
                    if (elements.length > 0) {
                        const index = elements[0].index;
                        const customerName = custLabels[index];
                        window.location.href = '@Url.Action("ProfitAnalysis", "Dashboard")?selectedCustomer=' + encodeURIComponent(customerName) + getActiveDateParams();
                    }
                }
            }
        });

        // DataTable Initialization
        $('#shipmentTable').DataTable({ pageLength: 10, scrollX: true });
    });
    </script>
    <script>
        // Carry the current filters (query string) across the sidebar module links.
        document.querySelectorAll('.nav-group .nav-link').forEach(function (a) { a.search = window.location.search; });
    </script>
</body>
</html>