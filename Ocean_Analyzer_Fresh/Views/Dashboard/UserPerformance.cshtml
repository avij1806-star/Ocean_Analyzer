@model Ocean_Analyzer_Fresh.Models.OceanShipmentDashboardViewModel
@using System.Data

@{
    ViewBag.Title = "User Performance & Workload Analysis";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewBag.Title</title>
    <!-- Fonts & Icons -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://api.fontshare.com/v2/css?f[]=general-sans@500,600,700&f[]=satoshi@400,500,700,900&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="@Url.Content("~/Content/date-filter.css")">
    <!-- DataTables CSS -->
    <link href="https://cdn.datatables.net/1.13.6/css/dataTables.bootstrap5.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.4/dist/chart.umd.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chartjs-plugin-datalabels@2.2.0"></script>
    <style>
        :root, [data-theme='light'] {
            --color-bg: #eef2f7;
            --color-surface: #ffffff;
            --color-surface-2: #f7f9fc;
            --color-surface-offset: #e8edf4;
            --color-border: #d8e0ea;
            --color-divider: #e3e9f1;
            --color-text: #0f1a2b;
            --color-text-muted: #5b6b81;
            --color-text-faint: #97a5b8;
            --color-primary: #0e7490;
            --color-primary-highlight: #d3ebf1;
            --color-secondary: #2c4a8a;
            --color-success: #157f4b;
            --color-error: #b3261e;
            --color-warning: #a35a09;
            --radius-md: 0.625rem;
            --radius-lg: 0.875rem;
            --shadow-sm: 0 1px 2px rgba(0,0,0,0.06);
            --font-display: 'General Sans', sans-serif;
            --font-body: 'Satoshi', sans-serif;
        }

        body {
            background-color: var(--color-bg);
            font-family: var(--font-body);
            color: var(--color-text);
            margin: 0;
            padding: 0;
            overflow-x: hidden;
        }

        .dashboard {
            display: grid;
            grid-template-columns: 240px 1fr;
            height: 100vh;
            transition: grid-template-columns 0.3s cubic-bezier(0.16, 1, 0.3, 1);
        }

            .dashboard.sidebar-collapsed {
                grid-template-columns: 0px 1fr;
            }

        .sidebar {
            background: var(--color-surface);
            border-right: 1px solid var(--color-border);
            display: flex;
            flex-direction: column;
            padding: 1.25rem 1rem;
            gap: 1.5rem;
            overflow-y: auto;
            overflow-x: hidden;
            white-space: nowrap;
            transition: opacity 0.2s ease, padding 0.3s ease;
        }

        .dashboard.sidebar-collapsed .sidebar {
            opacity: 0;
            padding: 0;
            pointer-events: none;
            border-right: none;
        }

        .brand {
            display: flex;
            align-items: center;
            gap: 0.75rem;
            font-family: var(--font-display);
            font-weight: 700;
            font-size: 0.9rem;
        }

            .brand svg {
                width: 32px;
                height: 32px;
                color: var(--color-primary);
                flex-shrink: 0;
            }

            .brand span {
                display: block;
                font-size: 0.75rem;
                color: var(--color-text-muted);
                font-weight: 500;
            }

        .nav-group {
            display: flex;
            flex-direction: column;
            gap: 0.25rem;
        }

        .nav-label {
            font-size: 0.7rem;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            color: var(--color-text-faint);
            font-weight: 700;
            padding: 0 0.5rem;
            margin-bottom: 0.25rem;
        }

        .nav-link {
            display: flex;
            align-items: center;
            gap: 0.75rem;
            padding: 0.5rem 0.75rem;
            border-radius: var(--radius-md);
            font-size: 0.85rem;
            color: var(--color-text-muted);
            font-weight: 500;
            text-decoration: none;
            border: none;
            background: none;
            width: 100%;
            text-align: left;
            cursor: pointer;
            transition: all 0.2s ease;
        }

            .nav-link:hover, .nav-link.active {
                background: var(--color-primary-highlight);
                color: var(--color-primary);
            }

        .main-col {
            display: flex;
            flex-direction: column;
            height: 100vh;
            overflow: hidden;
            min-width: 0;
        }

        .topbar {
            background: var(--color-surface);
            border-bottom: 1px solid var(--color-border);
            padding: 1.25rem 1.5rem;
            display: flex;
            flex-direction: column;
            gap: 1rem;
            flex-shrink: 0;
        }

        .topbar-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .topbar-title {
            font-size: 1.25rem;
            font-weight: 700;
            font-family: var(--font-display);
        }

        .sidebar-toggle-btn {
            background: var(--color-surface-offset);
            border: 1px solid var(--color-border);
            color: var(--color-text);
            border-radius: 8px;
            padding: 6px 10px;
            font-size: 14px;
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            transition: all 0.2s;
        }

            .sidebar-toggle-btn:hover {
                background: var(--color-primary-highlight);
                color: var(--color-primary);
            }

        .filters-row {
            display: flex;
            align-items: flex-end;
            gap: 0.85rem;
            flex-wrap: wrap;
        }

        .filter-field {
            display: flex;
            flex-direction: column;
            gap: 4px;
            flex: 1 1 130px;
            min-width: 120px;
        }

            .filter-field label {
                font-size: 10px;
                text-transform: uppercase;
                letter-spacing: 0.05em;
                color: #112b4f;
                font-weight: 700;
            }

        .form-select, .form-control {
            border-radius: 8px;
            border-color: var(--color-border);
            font-size: 12px;
            padding: 6px 10px;
        }

        .main-scroll {
            flex: 1;
            overflow-y: auto;
            padding: 1.75rem;
            display: flex;
            flex-direction: column;
            gap: 1.75rem;
        }

        .section {
            display: flex;
            flex-direction: column;
            gap: 1rem;
        }

        .section-title {
            font-size: 1.15rem;
            font-weight: 700;
            font-family: var(--font-display);
        }

        .kpi-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
            gap: 1rem;
        }

        .kpi-card {
            background: var(--color-surface);
            border: 1px solid var(--color-border);
            border-radius: var(--radius-lg);
            padding: 1.25rem;
            display: flex;
            flex-direction: column;
            gap: 0.5rem;
            box-shadow: var(--shadow-sm);
        }

        .kpi-label {
            font-size: 0.75rem;
            color: #091c36;
            font-weight: 600;
            display: flex;
            align-items: center;
            gap: 0.35rem;
        }

        .kpi-value {
            font-size: 1.5rem;
            font-weight: 700;
            font-family: var(--font-display);
        }

        .grid-2 {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 1rem;
        }

        @@media (max-width: 992px) {
            .grid-2 {
                grid-template-columns: 1fr;
            }
        }

        .panel {
            background: var(--color-surface);
            border: 1px solid var(--color-border);
            border-radius: var(--radius-lg);
            padding: 1.25rem;
            box-shadow: var(--shadow-sm);
            display: flex;
            flex-direction: column;
            gap: 1rem;
        }

        .panel-title {
            font-size: 0.9rem;
            font-weight: 700;
            font-family: var(--font-display);
        }

        .chart-wrap {
            position: relative;
            height: 280px;
        }

        .data-table {
            width: 100%;
            font-size: 0.8rem;
            border-collapse: collapse;
        }

            .data-table th, .data-table td {
                padding: 0.65rem 0.75rem;
                border-bottom: 1px solid var(--color-divider);
                text-align: left;
                white-space: nowrap;
            }

            .data-table th {
                background: var(--color-surface-2);
                font-weight: 700;
                color: var(--color-text-muted);
                font-size: 0.7rem;
                text-transform: uppercase;
            }

            .data-table tr:hover td {
                background: var(--color-surface-offset);
            }

        .tnum {
            font-variant-numeric: tabular-nums;
        }
    </style>
</head>
<body>

    <div class="dashboard" id="dashboardLayout">
        <!-- SIDEBAR NAVIGATION -->
        <aside class="sidebar" aria-label="Primary navigation">
            <div class="brand">
                <svg viewBox="0 0 32 32" fill="none"><rect width="32" height="32" rx="8" fill="currentColor" /><path d="M6 20.5l6-11 6 11M18 20.5l4-7.5 4 7.5" stroke="white" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round" /></svg>
                <div>Performance Dashboard <span>Load Access BI</span></div>
            </div>

            <nav class="nav-group">
                <div class="nav-label">Modules</div>
                <a href="@Url.Action("Ocean_Dashboard", "Dashboard")" class="nav-link"><i class="bi bi-grid-1x2-fill"></i> Executive Overview</a>
                <a href="@Url.Action("ProfitAnalysis", "Dashboard")" class="nav-link"><i class="bi bi-graph-up-arrow"></i> Profit &amp; Loss P&amp;L</a>
                <a href="@Url.Action("UserPerformance", "Dashboard")" class="nav-link active"><i class="bi bi-person-badge-fill"></i> User Productivity</a>
                <a href="@Url.Action("SalesPersonPerformance", "Dashboard")" class="nav-link"><i class="bi bi-people-fill"></i> Sales Performance</a>
                <a href="@Url.Action("StationTradeLane", "Dashboard")" class="nav-link"><i class="bi bi-compass-fill"></i> Company Trade Lanes</a>
                <a href="@Url.Action("CbmAnalysis", "Dashboard")" class="nav-link"><i class="bi bi-box-seam-fill"></i> CBM Volume</a>
                <a href="@Url.Action("Trends", "Dashboard")" class="nav-link"><i class="bi bi-activity"></i> Trends</a>
            </nav>
            @Html.Partial("_DateRangeLabel", Model)
        </aside>

        <!-- MAIN VIEW AREA -->
        <div class="main-col">
            <header class="topbar">
                <div class="topbar-header">
                    <div class="d-flex align-items-center gap-3">
                        <button type="button" id="sidebarToggleBtn" class="sidebar-toggle-btn" title="Expand/Collapse Sidebar">
                            <i class="bi bi-layout-sidebar"></i>
                        </button>
                        <div class="topbar-title">User Productivity &amp; Workload Module</div>
                    </div>
                </div>

                <!-- FULL MASTER FILTER BAR WITH CASCADING DROPDOWNS -->
                @using (Html.BeginForm("UserPerformance", "Dashboard", FormMethod.Get, new { @class = "filters-row", id = "filterForm" }))
                {
                    @Html.Partial("_DateFilter", Model)
                    <div class="filter-field">
                        <label>Companies</label>
                        @Html.DropDownList("selectedStation", new SelectList(Model.AvailableStations ?? new List<string>(), Model.SelectedStation), "-- All Companies --", new { @class = "form-select form-select-sm", id = "selectedStation" })
                    </div>
                    <div class="filter-field">
                        <label>Customer Account</label>
                        @Html.DropDownList("selectedCustomer", new SelectList(Model.AvailableCustomers ?? new List<string>(), Model.SelectedCustomer), "-- All Customers --", new { @class = "form-select form-select-sm", id = "selectedCustomer" })
                    </div>
                    <div class="filter-field">
                        <label>File Status</label>
                        @Html.DropDownList("selectedFileStatus", new SelectList(Model.AvailableFileStatuses ?? new List<string>(), Model.SelectedFileStatus), "-- All Statuses --", new { @class = "form-select form-select-sm" })
                    </div>
                    <div class="filter-field">
                        <label>Created By</label>
                        @Html.DropDownList("selectedCreatedBy", new SelectList(Model.AvailableCreatedBy ?? new List<string>(), Model.SelectedCreatedBy), "-- All Users --", new { @class = "form-select form-select-sm" })
                    </div>
                    @*<div class="filter-field">
                        <label>Salesperson</label>
                        @Html.DropDownList("selectedSalesPerson", new SelectList(Model.AvailableSalesPersons ?? new List<string>(), Model.SelectedSalesPerson), "-- All Sales Persons --", new { @class = "form-select form-select-sm", id = "selectedSalesPerson" })
                    </div>*@
                    <div class="filter-actions">
                        <button type="submit" id="submitBtn" class="btn btn-applied btn-sm px-3 py-1">Apply Filters</button>
                    </div>
                }
            </header>

            <main class="main-scroll" id="mainScroll">
                <!-- USER KPI METRICS -->
                <section class="section">
                    <div class="section-title">Productivity &amp; Volume Metrics</div>
                    <div class="kpi-grid">
                        <div class="kpi-card">
                            <div class="kpi-label"><i class="bi bi-folder-check"></i> Total Bookings Created</div>
                            <div class="kpi-value tnum">@Model.TotalShipments.ToString("N0") Files</div>
                        </div>
                        <div class="kpi-card">
                            <div class="kpi-label"><i class="bi bi-people-fill"></i> Active Operators</div>
                            <div class="kpi-value tnum text-primary">@Model.ShipmentsByUser.Keys.Count Active</div>
                        </div>
                    </div>
                </section>

                <!-- DUAL VISUALIZATION CHARTS -->
                <section class="section">
                    <div class="grid-2">
                        <!-- Operator Workload Distribution Doughnut Chart -->
                        <div class="panel">
                            <div class="panel-title"><i class="bi bi-pie-chart-fill text-success me-2"></i> Operator Workload Share (%)</div>
                            <div class="chart-wrap"><canvas id="userDoughnutChart"></canvas></div>
                        </div>

                        <!-- Top Operators by File Throughput Bar Chart -->
                        <div class="panel">
                            <div class="panel-title"><i class="bi bi-bar-chart-fill text-info me-2"></i> Top Operators by File Throughput</div>
                            <div class="chart-wrap"><canvas id="userVolumeBarChart"></canvas></div>
                        </div>
                    </div>
                </section>

                <!-- OPERATOR WORKLOAD & STATUS BACKLOG BREAKDOWN TABLE -->
                <section class="section">
                    <div class="panel" style="height: auto;">
                        <div class="panel-title"><i class="bi bi-folder2-open text-primary me-2"></i> Operator Workload &amp; Status Backlog Breakdown</div>
                        <div style="overflow-x: auto;">
                            <table class="data-table" id="operatorFinTable">
                                <thead>
                                    <tr>
                                        <th>Operator / Created By</th>
                                        <th>Total Files Handled</th>
                                        <th>Active / Open Files</th>
                                        <th>Closed / Posted Files</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (Model.OperatorFinancialData != null)
                                    {
                                        foreach (DataRow row in Model.OperatorFinancialData.Rows)
                                        {
                                            <tr>
                                                <td><strong>@row["Operator"]</strong></td>
                                                <td class="tnum fw-bold">@Convert.ToInt32(row["FilesHandled"]).ToString("N0")</td>
                                                <td class="tnum text-info">@Convert.ToInt32(row["ActiveFiles"]).ToString("N0")</td>
                                                <td class="tnum text-success">@Convert.ToInt32(row["ClosedFiles"]).ToString("N0")</td>
                                            </tr>
                                        }
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </section>

                <!-- USER PERFORMANCE LEDGER TABLE -->
                <section class="section">
                    <div class="panel" style="height: auto;">
                        <div class="panel-title">Staff Performance Ledger (@Model.ShipmentData.Rows.Count Records Loaded)</div>
                        <div style="overflow-x: auto;">
                            <table class="data-table" id="userPerformanceTable">
                                <thead>
                                    <tr>
                                        @foreach (DataColumn col in Model.ShipmentData.Columns)
                                        {
                                            <th>@col.ColumnName</th>
                                        }
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (DataRow row in Model.ShipmentData.Rows)
                                    {
                                        <tr>
                                            @foreach (var item in row.ItemArray)
                                            {
                                                <td>@item.ToString()</td>
                                            }
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </section>
            </main>
        </div>
    </div>

    <!-- Scripts -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>
    <script src="@Url.Content("~/Scripts/date-filter.js")"></script>
    <script>
    document.addEventListener("DOMContentLoaded", function () {
        Chart.register(ChartDataLabels);

        const toggleBtn = document.getElementById('sidebarToggleBtn');
        const dashboardLayout = document.getElementById('dashboardLayout');
        if (toggleBtn && dashboardLayout) {
            toggleBtn.addEventListener('click', function () {
                dashboardLayout.classList.toggle('sidebar-collapsed');
                setTimeout(function () { window.dispatchEvent(new Event('resize')); }, 300);
            });
        }

        // Dynamic Cascading Dropdown Logic (Companies -> Customers & Salespersons)
        $('#selectedStation').change(function () {
            var selectedStation = $(this).val();
            var customerDropdown = $('#selectedCustomer');
            var salesPersonDropdown = $('#selectedSalesPerson');

            customerDropdown.empty();
            customerDropdown.append($('<option></option>').val('').text('-- All Customers --'));

            salesPersonDropdown.empty();
            salesPersonDropdown.append($('<option></option>').val('').text('-- All Sales Persons --'));

            var isAllSelected = !selectedStation || selectedStation === '-- All Companies --' || selectedStation === '-- All Stations --';

            // 1. Fetch Customers via AJAX
            $.ajax({
                url: '@Url.Action("GetCustomersByStation", "Dashboard")',
                type: 'GET',
                data: { station: isAllSelected ? '' : selectedStation },
                success: function (customers) {
                    $.each(customers, function (i, customer) {
                        customerDropdown.append($('<option></option>').val(customer).text(customer));
                    });
                },
                error: function (xhr, status, error) {
                    console.error("Failed to fetch customers: " + error);
                }
            });

            // 2. Fetch Salespersons via AJAX
            $.ajax({
                url: '@Url.Action("GetSalesPersonsByStation", "Dashboard")',
                type: 'GET',
                data: { station: isAllSelected ? '' : selectedStation },
                success: function (salesPersons) {
                    $.each(salesPersons, function (i, sp) {
                        salesPersonDropdown.append($('<option></option>').val(sp).text(sp));
                    });
                },
                error: function (xhr, status, error) {
                    console.error("Failed to fetch salespersons: " + error);
                }
            });
        });

        // 1. Workload Distribution Doughnut Chart (Grouped to Top 5 + Other)
        const rawLabels = @Html.Raw(Model.ShipmentsByUser != null ? Json.Encode(Model.ShipmentsByUser.Keys.ToArray()) : "[]");
        const rawCounts = @Html.Raw(Model.ShipmentsByUser != null ? Json.Encode(Model.ShipmentsByUser.Values.ToArray()) : "[]");

        let userLabels = Array.isArray(rawLabels) ? rawLabels : [];
        let userCounts = Array.isArray(rawCounts) ? rawCounts : [];

        if (userLabels.length > 5) {
            const combined = userLabels.map((lbl, i) => ({ label: lbl, count: userCounts[i] }));
            combined.sort((a, b) => b.count - a.count);

            const top5 = combined.slice(0, 5);
            const others = combined.slice(5);
            const otherSum = others.reduce((sum, item) => sum + item.count, 0);

            userLabels = top5.map(x => x.label);
            userCounts = top5.map(x => x.count);

            if (otherSum > 0) {
                userLabels.push("Other");
                userCounts.push(otherSum);
            }
        }

        if (userLabels.length > 0) {
            const ctxDoughnut = document.getElementById('userDoughnutChart').getContext('2d');
            new Chart(ctxDoughnut, {
                type: 'doughnut',
                data: {
                    labels: userLabels,
                    datasets: [{
                        data: userCounts,
                        backgroundColor: ['#0e7490', '#157f4b', '#2c4a8a', '#a35a09', '#b3261e', '#94a3b8'],
                        borderWidth: 2,
                        borderColor: '#ffffff'
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: {
                            position: 'bottom',
                            labels: { boxWidth: 10, font: { size: 10 }, padding: 15 }
                        },
                        datalabels: {
                            color: '#fff',
                            font: { weight: 'bold', size: 10 },
                            formatter: (value) => value > 0 ? value : ''
                        }
                    }
                }
            });
        }

        // 2. Operator File Volume Horizontal Bar Chart
        const operatorData = @Html.Raw(Model.OperatorFinancialData != null ?
            Json.Encode(Model.OperatorFinancialData.Rows.Cast<DataRow>().Select(r => new {
                Operator = r["Operator"]?.ToString(),
                Files = Convert.ToInt32(r["FilesHandled"])
            }).Take(6).ToList()) : "[]");

        const opLabels = operatorData.map(x => x.Operator);
        const opValues = operatorData.map(x => x.Files);
        const maxOpVal = opValues.length > 0 ? Math.max(...opValues) : 100;

        if (opLabels.length > 0) {
            const ctxBar = document.getElementById('userVolumeBarChart').getContext('2d');
            new Chart(ctxBar, {
                type: 'bar',
                data: {
                    labels: opLabels,
                    datasets: [{
                        label: 'Files Handled',
                        data: opValues,
                        backgroundColor: '#0e7490',
                        borderRadius: 6
                    }]
                },
                options: {
                    indexAxis: 'y',
                    responsive: true,
                    maintainAspectRatio: false,
                    layout: { padding: { top: 15, right: 25 } },
                    plugins: {
                        legend: { display: false },
                        datalabels: {
                            anchor: 'end',
                            align: 'right',
                            font: { size: 10, weight: 'bold' },
                            color: '#1e293b',
                            formatter: (value) => value > 0 ? value : ''
                        }
                    },
                    scales: {
                        x: { beginAtZero: true, grid: { color: '#f1f5f9' }, suggestedMax: maxOpVal * 1.25 },
                        y: { grid: { display: false } }
                    }
                }
            });
        }

        $('#operatorFinTable').DataTable({ pageLength: 5, scrollX: true, lengthChange: false });
        $('#userPerformanceTable').DataTable({ pageLength: 10, scrollX: true });
    });
    </script>
    <script>
        // Carry the current filters (query string) across the sidebar module links.
        document.querySelectorAll('.nav-group .nav-link').forEach(function (a) { a.search = window.location.search; });
    </script>
</body>
</html>