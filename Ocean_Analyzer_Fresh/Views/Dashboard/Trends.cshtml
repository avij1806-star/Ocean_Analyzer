@model Ocean_Analyzer_Fresh.Models.OceanShipmentDashboardViewModel

@functions {
    static string Money(decimal v)
    {
        decimal a = Math.Abs(v);
        string s = a >= 1000000 ? (a / 1000000).ToString("0.##") + "M"
            : a >= 1000 ? (a / 1000).ToString("0.#") + "K"
            : a.ToString("0");
        return (v < 0 ? "-$" : "$") + s;
    }

    // Signed change vs the previous period: percent for counts and money, points for a percentage.
    static IHtmlString Delta(decimal current, decimal previous, bool isPercentPoints)
    {
        if (!isPercentPoints && previous == 0)
            return new HtmlString(current == 0 ? "<span class=\"delta delta-flat\">No change</span>" : "<span class=\"delta delta-flat\">New this period</span>");
        decimal change = isPercentPoints ? current - previous : (current - previous) / Math.Abs(previous) * 100;
        string text = (change > 0 ? "+" : change < 0 ? "-" : "") + Math.Abs(change).ToString("0.0") + (isPercentPoints ? " pts" : "%");
        if (Math.Round(change, 1) == 0) return new HtmlString("<span class=\"delta delta-flat\"><i class=\"bi bi-dash\"></i> 0.0" + (isPercentPoints ? " pts" : "%") + "</span>");
        string css = change > 0 ? "delta-up" : "delta-down";
        string icon = change > 0 ? "bi-arrow-up-right" : "bi-arrow-down-right";
        return new HtmlString("<span class=\"delta " + css + "\"><i class=\"bi " + icon + "\"></i> " + text + "</span>");
    }

    static string Inv(double d) { return d.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture); }

    static IHtmlString NoCompare()
    {
        return new HtmlString("<span class=\"delta delta-flat\" title=\"The previous period starts before the earliest data\">No earlier data to compare</span>");
    }

    static decimal Median(IEnumerable<decimal> values)
    {
        var sorted = values.OrderBy(v => v).ToList();
        if (sorted.Count == 0) return 0;
        int mid = sorted.Count / 2;
        return sorted.Count % 2 == 1 ? sorted[mid] : (sorted[mid - 1] + sorted[mid]) / 2;
    }

    static decimal Mean(IEnumerable<decimal> values)
    {
        var list = values.ToList();
        return list.Count == 0 ? 0 : list.Average();
    }

    // Volumes and weights: whole numbers once they are large, one decimal below 100.
    static string Qty(decimal v)
    {
        return Math.Abs(v) >= 100 ? v.ToString("N0") : v.ToString("N1");
    }

    // Below this share of shipments with a CBM value, revenue per CBM is shown faded as unreliable.
    const decimal MinCbmCoverage = 50;

    static IHtmlString CbmCell(Ocean_Analyzer_Fresh.Models.TrendVolume v)
    {
        if (v.Shipments == 0) return new HtmlString("–");
        if (v.CbmShipments == 0) return new HtmlString("<span class=\"vol-missing\" title=\"No shipment in this period has a CBM value\">Not recorded</span>");
        return new HtmlString(Qty(v.Cbm));
    }

    // Second line under a CBM value when only part of the shipments were measured.
    static IHtmlString CbmCoverage(Ocean_Analyzer_Fresh.Models.TrendVolume v)
    {
        if (v.CbmShipments == 0 || v.CbmCoveragePct >= 95) return new HtmlString("");
        return new HtmlString("<span class=\"vol-cov\" title=\"CBM recorded on " + v.CbmShipments + " of " + v.Shipments + " shipments\">" + v.CbmCoveragePct.ToString("0") + "% of shipments</span>");
    }

    static IHtmlString RevPerCbmCell(Ocean_Analyzer_Fresh.Models.TrendVolume v)
    {
        if (!v.RevenuePerCbm.HasValue) return new HtmlString("–");
        string text = "$" + v.RevenuePerCbm.Value.ToString("N0");
        if (v.CbmCoveragePct >= MinCbmCoverage) return new HtmlString(text);
        return new HtmlString("<span class=\"vol-weak\" title=\"Based on only " + v.CbmShipments + " of " + v.Shipments + " shipments\">" + text + "</span>");
    }

    static string SignedMoney(decimal v)
    {
        return (v > 0 ? "+" : "") + Money(v);
    }

    // Marker beside a value showing whether it is above or below the team median.
    static IHtmlString VsMedian(bool show, decimal value, decimal median, string medianText)
    {
        if (!show || value == median) return new HtmlString("");
        bool above = value > median;
        string text = (above ? "Above" : "Below") + " team median (" + HttpUtility.HtmlEncode(medianText) + ")";
        return new HtmlString("<i class=\"bi " + (above ? "bi-caret-up-fill vs-up" : "bi-caret-down-fill vs-down") + " vs-median\" title=\"" + text + "\" aria-label=\"" + text + "\"></i>");
    }

    // Small inline trend line: de-emphasised stroke, latest point in the accent color.
    static IHtmlString Spark(IList<decimal> values, int width, int height)
    {
        if (values == null || values.Count < 2) return new HtmlString("");
        decimal min = values.Min(), max = values.Max();
        decimal span = max - min == 0 ? 1 : max - min;
        var points = new System.Text.StringBuilder();
        double lastX = 0, lastY = 0;
        for (int i = 0; i < values.Count; i++)
        {
            lastX = 2 + i * (width - 4.0) / (values.Count - 1);
            lastY = height - 2 - (double)((values[i] - min) / span) * (height - 4);
            points.Append(lastX.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture)).Append(',')
                  .Append(lastY.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture)).Append(' ');
        }
        return new HtmlString("<svg class=\"spark\" width=\"" + width + "\" height=\"" + height + "\" viewBox=\"0 0 " + width + " " + height + "\" aria-hidden=\"true\">"
            + "<polyline fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linejoin=\"round\" stroke-linecap=\"round\" points=\"" + points.ToString().Trim() + "\" />"
            + "<circle cx=\"" + Inv(lastX) + "\" cy=\"" + Inv(lastY) + "\" r=\"2.5\" class=\"spark-end\" /></svg>");
    }
}

@{
    ViewBag.Title = "Trends";
    Layout = null;
    var T = Model.Trends ?? new Ocean_Analyzer_Fresh.Models.TrendsData();
    var cur = T.Current;
    var prev = T.Previous;
    string unit = T.Grain == "month" ? "month" : "week";
    DateTime prevFromDate, prevToDate;
    string prevText = DateTime.TryParse(T.PreviousFrom, out prevFromDate) && DateTime.TryParse(T.PreviousTo, out prevToDate)
        ? prevFromDate.ToString("dd MMM yyyy") + " – " + prevToDate.ToString("dd MMM yyyy")
        : "";
    string json = Newtonsoft.Json.JsonConvert.SerializeObject(T, new Newtonsoft.Json.JsonSerializerSettings { StringEscapeHandling = Newtonsoft.Json.StringEscapeHandling.EscapeHtml });
    bool compare = !T.PreviousIncomplete;
    string dateQuery = "&fromDate=" + Url.Encode(Model.FromDate) + "&toDate=" + Url.Encode(Model.ToDate) + "&dateType=" + Url.Encode(Model.DateType);
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewBag.Title</title>

    <!-- Fonts & Icons -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://api.fontshare.com/v2/css?f[]=general-sans@500,600,700&f[]=satoshi@400,500,700,900&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="@Url.Content("~/Content/date-filter.css")?v=2">
    <!-- DataTables CSS -->
    <link href="https://cdn.datatables.net/1.13.6/css/dataTables.bootstrap5.min.css" rel="stylesheet">

    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.4/dist/chart.umd.min.js"></script>

    <!-- EMBEDDED STYLES -->
    <style>
        :root, [data-theme='light'] {
            --color-bg: #eef2f7;
            --color-surface: #ffffff;
            --color-surface-2: #f7f9fc;
            --color-surface-offset: #e8edf4;
            --color-border: #d8e0ea;
            --color-divider: #e3e9f1;
            --color-text: #0f1a2b;
            --color-text-muted: #5b6b81;
            --color-text-faint: #97a5b8;
            --color-primary: #0e7490;
            --color-primary-highlight: #d3ebf1;
            --color-secondary: #2c4a8a;
            --color-success: #157f4b;
            --color-error: #b3261e;
            --color-warning: #a35a09;
            --radius-md: 0.625rem;
            --radius-lg: 0.875rem;
            --shadow-sm: 0 1px 2px rgba(0,0,0,0.06);
            --font-display: 'General Sans', sans-serif;
            --font-body: 'Satoshi', sans-serif;
        }

        body {
            background-color: var(--color-bg);
            font-family: var(--font-body);
            color: var(--color-text);
            margin: 0;
            padding: 0;
            overflow-x: hidden;
        }

        .dashboard {
            display: grid;
            grid-template-columns: 240px 1fr;
            height: 100vh;
            transition: grid-template-columns 0.3s cubic-bezier(0.16, 1, 0.3, 1);
        }

            .dashboard.sidebar-collapsed {
                grid-template-columns: 0px 1fr;
            }

        .sidebar {
            background: var(--color-surface);
            border-right: 1px solid var(--color-border);
            display: flex;
            flex-direction: column;
            padding: 1.25rem 1rem;
            gap: 1.5rem;
            overflow-y: auto;
            overflow-x: hidden;
            white-space: nowrap;
            transition: opacity 0.2s ease, padding 0.3s ease;
        }

        .dashboard.sidebar-collapsed .sidebar {
            opacity: 0;
            padding: 0;
            pointer-events: none;
            border-right: none;
        }

        .brand {
            display: flex;
            align-items: center;
            gap: 0.75rem;
            font-family: var(--font-display);
            font-weight: 700;
            font-size: 0.9rem;
        }

            .brand svg {
                width: 32px;
                height: 32px;
                color: var(--color-primary);
                flex-shrink: 0;
            }

            .brand span {
                display: block;
                font-size: 0.75rem;
                color: var(--color-text-muted);
                font-weight: 500;
            }

        .nav-group {
            display: flex;
            flex-direction: column;
            gap: 0.25rem;
        }

        .nav-label {
            font-size: 0.7rem;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            color: var(--color-text-faint);
            font-weight: 700;
            padding: 0 0.5rem;
            margin-bottom: 0.25rem;
        }

        .nav-link {
            display: flex;
            align-items: center;
            gap: 0.75rem;
            padding: 0.5rem 0.75rem;
            border-radius: var(--radius-md);
            font-size: 0.85rem;
            color: var(--color-text-muted);
            font-weight: 500;
            text-decoration: none;
            border: none;
            background: none;
            width: 100%;
            text-align: left;
            cursor: pointer;
            transition: all 0.2s ease;
        }

            .nav-link:hover, .nav-link.active {
                background: var(--color-primary-highlight);
                color: var(--color-primary);
            }

        .main-col {
            display: flex;
            flex-direction: column;
            height: 100vh;
            overflow: hidden;
            min-width: 0;
        }

        .topbar {
            background: var(--color-surface);
            border-bottom: 1px solid var(--color-border);
            padding: 1rem 1.5rem;
            display: flex;
            flex-direction: column;
            gap: 0.75rem;
            flex-shrink: 0;
        }

        .topbar-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .topbar-title {
            font-size: 1.25rem;
            font-weight: 700;
            font-family: var(--font-display);
        }

        .sidebar-toggle-btn {
            background: var(--color-surface-offset);
            border: 1px solid var(--color-border);
            color: var(--color-text);
            border-radius: 8px;
            padding: 6px 10px;
            font-size: 14px;
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            transition: all 0.2s;
        }

            .sidebar-toggle-btn:hover {
                background: var(--color-primary-highlight);
                color: var(--color-primary);
            }

        .filters-row {
            display: flex;
            align-items: flex-end;
            gap: 0.75rem;
            flex-wrap: wrap;
        }

        .filter-field {
            display: flex;
            flex-direction: column;
            gap: 2px;
        }

            .filter-field label {
                font-size: 10px;
                text-transform: uppercase;
                letter-spacing: 0.05em;
                color: #112b4f;
                font-weight: 700;
            }

        .form-select, .form-control {
            border-radius: 8px;
            border-color: var(--color-border);
            font-size: 12px;
            padding: 6px 10px;
        }

        .main-scroll {
            flex: 1;
            overflow-y: auto;
            padding: 1.5rem;
            display: flex;
            flex-direction: column;
            gap: 2rem;
        }

        .section {
            display: flex;
            flex-direction: column;
            gap: 1rem;
        }

        .section-title {
            font-size: 1.15rem;
            font-weight: 700;
            font-family: var(--font-display);
        }

        .kpi-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 1rem;
        }

        .kpi-card {
            background: var(--color-surface);
            border: 1px solid var(--color-border);
            border-radius: var(--radius-lg);
            padding: 1.25rem;
            display: flex;
            flex-direction: column;
            gap: 0.5rem;
            box-shadow: var(--shadow-sm);
        }

        .kpi-label {
            font-size: 0.75rem;
            color: #091c36;
            font-weight: 600;
            display: flex;
            align-items: center;
            gap: 0.35rem;
        }

        .kpi-value {
            font-size: 1.5rem;
            font-weight: 700;
            font-family: var(--font-display);
        }

        .grid-2 {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 1rem;
        }

        @@media (max-width: 1200px) {
            .grid-2 {
                grid-template-columns: 1fr;
            }
        }

        .panel {
            background: var(--color-surface);
            border: 1px solid var(--color-border);
            border-radius: var(--radius-lg);
            padding: 1.25rem;
            box-shadow: var(--shadow-sm);
            display: flex;
            flex-direction: column;
            gap: 1rem;
        }

        .panel-title {
            font-size: 0.9rem;
            font-weight: 700;
            font-family: var(--font-display);
        }

        .chart-wrap {
            position: relative;
            height: 320px;
            width: 100%;
        }

        .data-table {
            width: 100%;
            font-size: 0.8rem;
            border-collapse: collapse;
        }

            .data-table th, .data-table td {
                padding: 0.65rem 0.75rem;
                border-bottom: 1px solid var(--color-divider);
                text-align: left;
                white-space: nowrap;
            }

            .data-table th {
                background: var(--color-surface-2);
                font-weight: 700;
                color: var(--color-text-muted);
                font-size: 0.7rem;
                text-transform: uppercase;
            }

            .data-table tr:hover td {
                background: var(--color-surface-offset);
            }

        .tnum {
            font-variant-numeric: tabular-nums;
        }

        /* ---- Trends page ---- */

        :root {
            /* Chart series colors (validated categorical order) and chart chrome */
            --series-1: #2a78d6;
            --series-2: #eb6834;
            --series-3: #1baf7a;
            --series-4: #eda100;
            --series-5: #e87ba4;
            --series-other: #98a2b0;
            --chart-grid: #e3e9f1;
            --chart-ink: #5b6b81;
        }

        .section-head {
            display: flex;
            align-items: baseline;
            justify-content: space-between;
            gap: 1rem;
            flex-wrap: wrap;
        }

        .section-sub {
            font-size: 0.75rem;
            color: var(--color-text-muted);
        }

        .kpi-value {
            font-variant-numeric: normal;
        }

        .kpi-foot {
            display: flex;
            align-items: flex-end;
            justify-content: space-between;
            gap: 0.5rem;
        }

        .delta {
            display: inline-flex;
            align-items: center;
            gap: 2px;
            font-size: 0.75rem;
            font-weight: 600;
            white-space: nowrap;
        }

        .delta-up { color: var(--color-success); }
        .delta-down { color: var(--color-error); }
        .delta-flat { color: var(--color-text-muted); font-weight: 500; }

        .spark {
            color: var(--color-text-faint);
            flex-shrink: 0;
        }

            .spark .spark-end {
                fill: var(--series-1);
            }

        .trend-tabs {
            display: inline-flex;
            padding: 3px;
            border-radius: 10px;
            background: var(--color-surface-offset);
            align-self: flex-start;
        }

            .trend-tabs button {
                border: 0;
                background: none;
                padding: 6px 16px;
                border-radius: 8px;
                font-size: 0.85rem;
                font-weight: 600;
                color: var(--color-text-muted);
            }

                .trend-tabs button[aria-selected="true"] {
                    background: var(--color-surface);
                    color: var(--color-primary);
                    box-shadow: 0 1px 2px rgba(15, 26, 43, 0.12);
                }

        .panel-head {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 0.75rem;
        }

        .panel-sub {
            font-size: 0.75rem;
            color: var(--color-text-muted);
            font-weight: 500;
        }

        .view-toggle {
            border: 1px solid var(--color-border);
            background: var(--color-surface);
            color: var(--color-text-muted);
            border-radius: 6px;
            font-size: 0.72rem;
            font-weight: 600;
            padding: 3px 10px;
        }

            .view-toggle:hover {
                color: var(--color-text);
                background: var(--color-surface-2);
            }

        .chart-table-wrap {
            max-height: 320px;
            overflow: auto;
        }

        .data-table td.num, .data-table th.num {
            text-align: right;
            font-variant-numeric: tabular-nums;
        }

        .table-actions {
            display: flex;
            gap: 6px;
        }

        .entity-link {
            color: var(--color-text);
            text-decoration: none;
            font-weight: 600;
        }

            .entity-link:hover {
                color: var(--color-primary);
                text-decoration: underline;
            }

        .trend-note {
            font-size: 0.75rem;
            color: var(--color-text-muted);
            margin: 0;
        }

        /* Week / Month switch in the filter bar, sized like the other controls. */
        .grain-switch {
            height: 32px;
            min-width: 140px;
        }

            .grain-switch label {
                display: flex;
                align-items: center;
                justify-content: center;
                padding: 0 12px;
            }

        .data-table thead tr.bench-row td {
            background: var(--color-primary-highlight);
            color: var(--color-text);
            font-weight: 700;
            font-size: 0.8rem;
            border-bottom: 1px solid var(--color-border);
        }

        .bench-n {
            font-weight: 500;
            font-size: 0.72rem;
            color: var(--color-text-muted);
            display: block;
        }

        .vs-median {
            font-size: 0.6rem;
            margin-left: 4px;
            vertical-align: 1px;
        }

        .vs-up { color: var(--color-success); }

        .table-scroll {
            overflow-x: auto;
        }

        .dt-top,
        .dt-bottom {
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            justify-content: space-between;
            gap: 0.5rem;
        }

        /* Long customer names wrap so the volume columns fit without scrolling on a laptop screen. */
        #customerTable td:first-child,
        #salesTable td:first-child {
            white-space: normal;
            min-width: 140px;
            max-width: 220px;
        }

        #customerTable td,
        #salesTable td {
            padding-left: 0.6rem;
            padding-right: 0.6rem;
        }

        .kpi-sub {
            font-size: 0.72rem;
            color: var(--color-text-muted);
            margin-top: -0.35rem;
        }

        .data-table td.num {
            white-space: nowrap;
        }

        .vol-cov {
            display: block;
            font-size: 0.68rem;
            color: var(--color-text-muted);
            font-weight: 500;
        }

        .vol-missing,
        .vol-weak {
            color: var(--color-text-muted);
        }

        .vol-weak {
            text-decoration: underline dotted;
            text-underline-offset: 3px;
        }
        .vs-down { color: var(--color-error); }

        [hidden] {
            display: none !important;
        }
    </style>
</head>
<body>

    <div class="dashboard" id="dashboardLayout">
        <!-- SIDEBAR NAVIGATION -->
        <aside class="sidebar" aria-label="Primary navigation">
            <div class="brand">
                <svg viewBox="0 0 32 32" fill="none"><rect width="32" height="32" rx="8" fill="currentColor" /><path d="M6 20.5l6-11 6 11M18 20.5l4-7.5 4 7.5" stroke="white" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round" /></svg>
                <div>Performance Dashboard <span>Load Access BI</span></div>
            </div>

            <nav class="nav-group">
                <div class="nav-label">Modules</div>
                <a href="@Url.Action("Ocean_Dashboard", "Dashboard")" class="nav-link"><i class="bi bi-grid-1x2-fill"></i> Executive Overview</a>
                <a href="@Url.Action("ProfitAnalysis", "Dashboard")" class="nav-link"><i class="bi bi-graph-up-arrow"></i> Profit &amp; Loss P&amp;L</a>
                <a href="@Url.Action("UserPerformance", "Dashboard")" class="nav-link"><i class="bi bi-person-badge-fill"></i> User Productivity</a>
                <a href="@Url.Action("SalesPersonPerformance", "Dashboard")" class="nav-link"><i class="bi bi-people-fill"></i> Sales Performance</a>
                <a href="@Url.Action("StationTradeLane", "Dashboard")" class="nav-link"><i class="bi bi-compass-fill"></i> Company Trade Lanes</a>
                <a href="@Url.Action("Trends", "Dashboard")" class="nav-link active"><i class="bi bi-activity"></i> Trends</a>
            </nav>
            @Html.Partial("_DateRangeLabel", Model)
        </aside>

        <!-- MAIN VIEW AREA -->
        <div class="main-col">
            <header class="topbar">
                <div class="topbar-header">
                    <div class="d-flex align-items-center gap-3">
                        <button type="button" id="sidebarToggleBtn" class="sidebar-toggle-btn" title="Expand/Collapse Sidebar">
                            <i class="bi bi-layout-sidebar"></i>
                        </button>
                        <div class="topbar-title">Trends</div>
                    </div>
                </div>

                <!-- FILTER BAR -->
                @using (Html.BeginForm("Trends", "Dashboard", FormMethod.Get, new { @class = "filters-row" }))
                {
                    @Html.Partial("_DateFilter", Model)
                    <input type="hidden" name="selectedFileStatus" value="@Request.QueryString["selectedFileStatus"]" />
                    <input type="hidden" name="selectedCreatedBy" value="@Request.QueryString["selectedCreatedBy"]" />
                    <div class="filter-field">
                        <label>Companies</label>
                        @Html.DropDownList("selectedStation", new SelectList(Model.AvailableStations, Model.SelectedStation), "-- All Companies --", new { @id = "selectedStation", @class = "form-select form-select-sm" })
                    </div>
                    <div class="filter-field">
                        <label>Customer Account</label>
                        @Html.DropDownList("selectedCustomer", new SelectList(Model.AvailableCustomers, Model.SelectedCustomer), "-- All Customers --", new { @id = "selectedCustomer", @class = "form-select form-select-sm" })
                    </div>
                    <div class="filter-field">
                        <label>Salesperson</label>
                        @Html.DropDownList("selectedSalesPerson", new SelectList(Model.AvailableSalesPersons, Model.SelectedSalesPerson), "-- All Sales Persons --", new { @id = "selectedSalesPerson", @class = "form-select form-select-sm" })
                    </div>
                    <div class="filter-field">
                        <label>Mode</label>
                        @Html.DropDownList("selectedMode", new SelectList(Model.AvailableModes, Model.SelectedMode), "-- All Modes --", new { @id = "selectedMode", @class = "form-select form-select-sm" })
                    </div>
                    <div class="filter-field">
                        <label>Group By</label>
                        <div class="date-basis grain-switch" role="radiogroup" aria-label="Group by">
                            <input type="radio" class="btn-check" name="grain" id="grainWeek" value="week" @(Model.Grain == "week" ? "checked" : "")>
                            <label for="grainWeek">Week</label>
                            <input type="radio" class="btn-check" name="grain" id="grainMonth" value="month" @(Model.Grain == "month" ? "checked" : "")>
                            <label for="grainMonth">Month</label>
                        </div>
                    </div>
                    <div class="filter-actions">
                    </div>
                }
            </header>

            <main class="main-scroll" id="mainScroll">
                @if (ViewBag.ErrorMessage != null)
                {
                    <div class="alert alert-danger" role="alert"><i class="bi bi-exclamation-triangle-fill me-2"></i> @ViewBag.ErrorMessage</div>
                }

                <!-- HEADLINE METRICS -->
                <section class="section">
                    <div class="section-head">
                        <div class="section-title">Headline Metrics</div>
                        <div class="section-sub">
                            @if (prevText == "")
                            {
                            }
                            else if (compare)
                            {
                                @:Change vs previous period (@prevText)
                            }
                            else
                            {
                                @:No comparison: the previous period (@prevText) starts before the data does
                            }
                        </div>
                    </div>
                    <div class="kpi-grid">
                        <div class="kpi-card">
                            <div class="kpi-label"><i class="bi bi-box-seam"></i> Shipments</div>
                            <div class="kpi-value">@cur.Shipments.ToString("N0")</div>
                            <div class="kpi-foot">@(compare ? Delta(cur.Shipments, prev.Shipments, false) : NoCompare()) @Spark(T.Shipments.Select(v => (decimal)v).ToList(), 110, 30)</div>
                        </div>
                        <div class="kpi-card">
                            <div class="kpi-label"><i class="bi bi-cash-stack"></i> Invoiced Revenue</div>
                            <div class="kpi-value" title="$@cur.Revenue.ToString("N2")">@Money(cur.Revenue)</div>
                            <div class="kpi-foot">@(compare ? Delta(cur.Revenue, prev.Revenue, false) : NoCompare()) @Spark(T.Revenue, 110, 30)</div>
                        </div>
                        <div class="kpi-card">
                            <div class="kpi-label"><i class="bi bi-star-fill"></i> Gross Profit</div>
                            <div class="kpi-value" title="$@cur.GrossProfit.ToString("N2")">@Money(cur.GrossProfit)</div>
                            <div class="kpi-foot">@(compare ? Delta(cur.GrossProfit, prev.GrossProfit, false) : NoCompare()) @Spark(T.GrossProfit, 110, 30)</div>
                        </div>
                        <div class="kpi-card">
                            <div class="kpi-label"><i class="bi bi-percent"></i> Gross Margin</div>
                            <div class="kpi-value">@(cur.MarginPct.HasValue ? cur.MarginPct.Value.ToString("0.0") + "%" : "–")</div>
                            <div class="kpi-foot">
                                @if (!compare)
                                {
                                    @NoCompare()
                                }
                                else if (cur.MarginPct.HasValue && prev.MarginPct.HasValue)
                                {
                                    @Delta(cur.MarginPct.Value, prev.MarginPct.Value, true)
                                }
                                else
                                {
                                    <span class="delta delta-flat">No previous data</span>
                                }
                                @Spark(T.MarginPct.Where(v => v.HasValue).Select(v => v.Value).ToList(), 110, 30)
                            </div>
                        </div>
                        <div class="kpi-card">
                            <div class="kpi-label"><i class="bi bi-boxes"></i> Volume (CBM)</div>
                            <div class="kpi-value" title="@cur.Cbm.ToString("N2") CBM">@Qty(cur.Cbm)</div>
                            <div class="kpi-sub" title="CBM recorded on @cur.CbmShipments of @cur.Shipments shipments. Full-container exports are mostly recorded by weight only.">
                                @cur.CbmCoveragePct.ToString("0")% of shipments measured · @Qty(cur.Tonnes) t
                            </div>
                            <div class="kpi-foot">@(compare ? Delta(cur.Cbm, prev.Cbm, false) : NoCompare()) @Spark(T.Cbm, 110, 30)</div>
                        </div>
                    </div>
                </section>

                <div class="trend-tabs" role="tablist" aria-label="Trend views">
                    <button type="button" role="tab" id="tabBtnBusiness" aria-controls="tabBusiness" aria-selected="true">Business</button>
                    <button type="button" role="tab" id="tabBtnCustomers" aria-controls="tabCustomers" aria-selected="false">Customers &amp; Sales</button>
                </div>

                <!-- BUSINESS TAB -->
                <section class="section" id="tabBusiness" role="tabpanel" aria-labelledby="tabBtnBusiness">
                    <div class="grid-2">
                        <div class="panel" data-chart-panel>
                            <div class="panel-head">
                                <div class="panel-title"><i class="bi bi-graph-up me-2"></i>Revenue, Cost &amp; Gross Profit <span class="panel-sub">per @unit</span></div>
                                <button type="button" class="view-toggle" data-view-toggle>Table</button>
                            </div>
                            <div class="chart-wrap"><canvas id="moneyChart" aria-label="Revenue, cost and gross profit per @unit" role="img"></canvas></div>
                            <div class="chart-table-wrap" data-chart-table hidden></div>
                        </div>
                        <div class="panel" data-chart-panel>
                            <div class="panel-head">
                                <div class="panel-title"><i class="bi bi-percent me-2"></i>Gross Margin % <span class="panel-sub">per @unit</span></div>
                                <button type="button" class="view-toggle" data-view-toggle>Table</button>
                            </div>
                            <div class="chart-wrap"><canvas id="marginChart" aria-label="Gross margin percent per @unit" role="img"></canvas></div>
                            <div class="chart-table-wrap" data-chart-table hidden></div>
                        </div>
                        <div class="panel" data-chart-panel>
                            <div class="panel-head">
                                <div class="panel-title"><i class="bi bi-box-seam me-2"></i>Shipments by Type <span class="panel-sub">per @unit</span></div>
                                <button type="button" class="view-toggle" data-view-toggle>Table</button>
                            </div>
                            <div class="chart-wrap"><canvas id="shipmentsChart" aria-label="Shipments by booking type per @unit" role="img"></canvas></div>
                            <div class="chart-table-wrap" data-chart-table hidden></div>
                        </div>
                        <div class="panel" data-chart-panel>
                            <div class="panel-head">
                                <div class="panel-title"><i class="bi bi-buildings me-2"></i>Gross Profit by Company <span class="panel-sub">top 5 by revenue, per @unit</span></div>
                                <button type="button" class="view-toggle" data-view-toggle>Table</button>
                            </div>
                            <div class="chart-wrap"><canvas id="companyChart" aria-label="Gross profit by company per @unit" role="img"></canvas></div>
                            <div class="chart-table-wrap" data-chart-table hidden></div>
                        </div>
                    </div>
                </section>

                <!-- CUSTOMERS & SALES TAB -->
                <section class="section" id="tabCustomers" role="tabpanel" aria-labelledby="tabBtnCustomers" hidden>
                    @foreach (var table in new[] {
                        new { Id = "customerTable", Title = "Customers", Icon = "bi-person-vcard", Rows = T.Customers, Action = "ProfitAnalysis", Param = "selectedCustomer", Bench = false },
                        new { Id = "salesTable", Title = "Salespeople", Icon = "bi-people-fill", Rows = T.SalesPersons, Action = "SalesPersonPerformance", Param = "selectedSalesPerson", Bench = true } })
                    {
                        // Team benchmark: salespeople with shipments this period, leaving out "Unassigned".
                        var peers = table.Rows.Where(x => x.Shipments > 0 && x.Name != "Unassigned").ToList();
                        bool bench = table.Bench && peers.Count > 1;
                        var peerMargins = peers.Where(x => x.Revenue > 0).Select(x => x.GrossProfit / x.Revenue * 100).ToList();
                        decimal medShipments = Median(peers.Select(x => (decimal)x.Shipments));
                        decimal medRevenue = Median(peers.Select(x => x.Revenue));
                        decimal medChange = Median(peers.Select(x => x.Revenue - x.PreviousRevenue));
                        decimal medGp = Median(peers.Select(x => x.GrossProfit));
                        decimal medMargin = Median(peerMargins);
                        var peerRevPerCbm = peers.Where(x => x.RevenuePerCbm.HasValue && x.CbmCoveragePct >= MinCbmCoverage).Select(x => x.RevenuePerCbm.Value).ToList();
                        decimal medCbm = Median(peers.Select(x => x.Cbm));
                        decimal medTonnes = Median(peers.Select(x => x.Tonnes));
                        decimal medRevPerCbm = Median(peerRevPerCbm);
                        <div class="panel">
                            <div class="panel-head">
                                <div class="panel-title"><i class="bi @table.Icon me-2"></i>@table.Title <span class="panel-sub">revenue vs previous period</span></div>
                                <div class="table-actions" @(compare ? "" : "hidden")>
                                    <button type="button" class="view-toggle" data-sort-table="#@table.Id" data-sort-dir="desc"><i class="bi bi-arrow-up-right"></i> Biggest gains</button>
                                    <button type="button" class="view-toggle" data-sort-table="#@table.Id" data-sort-dir="asc"><i class="bi bi-arrow-down-right"></i> Biggest drops</button>
                                </div>
                            </div>
                            <table id="@table.Id" class="data-table" style="width:100%">
                                <thead>
                                    <tr>
                                        <th>Name</th>
                                        <th class="num">Shipments</th>
                                        <th class="num">Revenue</th>
                                        @if (compare)
                                        {
                                            <th class="num">Change vs prev.</th>
                                        }
                                        <th class="num">Gross profit</th>
                                        <th class="num">Margin</th>
                                        <th class="num" title="Cubic metres shipped">CBM</th>
                                        <th class="num" title="Weight shipped, in metric tonnes">Tonnes</th>
                                        <th class="num" title="Revenue of the shipments that have a CBM value, divided by their CBM">Rev / CBM</th>
                                        <th title="Revenue per period">Trend</th>
                                    </tr>
                                    @if (bench)
                                    {
                                        foreach (var row in new[] {
                                            new { Label = "Team average", Ship = Mean(peers.Select(x => (decimal)x.Shipments)).ToString("N1"), Rev = Money(Mean(peers.Select(x => x.Revenue))), Chg = SignedMoney(Mean(peers.Select(x => x.Revenue - x.PreviousRevenue))), Gp = Money(Mean(peers.Select(x => x.GrossProfit))), Margin = Mean(peerMargins).ToString("0.0") + "%", Cbm = Qty(Mean(peers.Select(x => x.Cbm))), Tonnes = Qty(Mean(peers.Select(x => x.Tonnes))), RevCbm = peerRevPerCbm.Count > 0 ? "$" + Mean(peerRevPerCbm).ToString("N0") : "–" },
                                            new { Label = "Team median", Ship = medShipments.ToString("N0"), Rev = Money(medRevenue), Chg = SignedMoney(medChange), Gp = Money(medGp), Margin = medMargin.ToString("0.0") + "%", Cbm = Qty(medCbm), Tonnes = Qty(medTonnes), RevCbm = peerRevPerCbm.Count > 0 ? "$" + medRevPerCbm.ToString("N0") : "–" } })
                                        {
                                            <tr class="bench-row">
                                                <td>@row.Label <span class="bench-n">across @peers.Count salespeople</span></td>
                                                <td class="num">@row.Ship</td>
                                                <td class="num">@row.Rev</td>
                                                @if (compare)
                                                {
                                                    <td class="num">@row.Chg</td>
                                                }
                                                <td class="num">@row.Gp</td>
                                                <td class="num">@row.Margin</td>
                                                <td class="num">@row.Cbm</td>
                                                <td class="num">@row.Tonnes</td>
                                                <td class="num">@row.RevCbm</td>
                                                <td></td>
                                            </tr>
                                        }
                                    }
                                </thead>
                                <tbody>
                                    @foreach (var r in table.Rows.Where(x => compare || x.Shipments > 0))
                                    {
                                        decimal change = r.Revenue - r.PreviousRevenue;
                                        <tr>
                                            <td><a class="entity-link" href="@Url.Action(table.Action, "Dashboard")?@(table.Param)=@Url.Encode(r.Name)@dateQuery">@r.Name</a></td>
                                            <td class="num" data-order="@r.Shipments">@r.Shipments.ToString("N0")@VsMedian(bench && r.Shipments > 0, r.Shipments, medShipments, medShipments.ToString("N0"))</td>
                                            <td class="num" data-order="@r.Revenue">@Money(r.Revenue)@VsMedian(bench && r.Shipments > 0, r.Revenue, medRevenue, Money(medRevenue))</td>
                                            @if (compare)
                                            {
                                            <td class="num" data-order="@change">
                                                @if (r.PreviousRevenue == 0 && r.Revenue != 0)
                                                {
                                                    <span class="delta delta-up"><i class="bi bi-plus-circle"></i> New</span>
                                                }
                                                else if (r.Revenue == 0 && r.PreviousRevenue != 0)
                                                {
                                                    <span class="delta delta-down"><i class="bi bi-dash-circle"></i> None this period (@Money(-r.PreviousRevenue))</span>
                                                }
                                                else
                                                {
                                                    <span class="me-1">@(change >= 0 ? "+" : "")@Money(change)</span>@Delta(r.Revenue, r.PreviousRevenue, false)
                                                }
                                            </td>
                                            }
                                            <td class="num" data-order="@r.GrossProfit">@Money(r.GrossProfit)@VsMedian(bench && r.Shipments > 0, r.GrossProfit, medGp, Money(medGp))</td>
                                            <td class="num" data-order="@(r.Revenue > 0 ? r.GrossProfit / r.Revenue * 100 : 0)">@(r.Revenue > 0 ? (r.GrossProfit / r.Revenue * 100).ToString("0.0") + "%" : "–")@VsMedian(bench && r.Revenue > 0, r.Revenue > 0 ? r.GrossProfit / r.Revenue * 100 : 0, medMargin, medMargin.ToString("0.0") + "%")</td>
                                            <td class="num" data-order="@r.Cbm">@CbmCell(r)@VsMedian(bench && r.CbmShipments > 0, r.Cbm, medCbm, Qty(medCbm))@CbmCoverage(r)</td>
                                            <td class="num" data-order="@r.Tonnes">@(r.WeightKg > 0 ? Qty(r.Tonnes) : "–")@VsMedian(bench && r.WeightKg > 0, r.Tonnes, medTonnes, Qty(medTonnes))</td>
                                            <td class="num" data-order="@(r.RevenuePerCbm ?? 0)">@RevPerCbmCell(r)@VsMedian(bench && peerRevPerCbm.Count > 1 && r.RevenuePerCbm.HasValue && r.CbmCoveragePct >= MinCbmCoverage, r.RevenuePerCbm ?? 0, medRevPerCbm, "$" + medRevPerCbm.ToString("N0"))</td>
                                            <td>@Spark(r.RevenueByBucket, 80, 24)</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                            @if (bench)
                            {
                                <p class="trend-note"><i class="bi bi-caret-up-fill vs-up"></i><i class="bi bi-caret-down-fill vs-down me-1"></i>Above or below the team median. Team figures cover salespeople with shipments in this period and leave out "Unassigned"; margin averages each salesperson's margin; revenue per CBM uses only salespeople with CBM on at least half their shipments.</p>
                            }
                        </div>
                    }
                </section>

                <p class="trend-note">
                    <i class="bi bi-info-circle me-1"></i>
                    Dashed lines and faded bars mark a @unit the selected range only partly covers.
                    Amounts add CAD and USD together, as on the other dashboards.
                    CBM is recorded on only some shipments (full-container exports usually carry weight only), so each CBM figure shows the share of shipments it covers; revenue per CBM is faded when that share is under half.
                    Volumes over 2,000 CBM on a single booking are treated as entry errors and left out.
                </p>
            </main>
        </div>
    </div>

    <!-- SCRIPTS -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>
    <script src="@Url.Content("~/Scripts/date-filter.js")?v=2"></script>
    <script>
    document.addEventListener("DOMContentLoaded", function () {
        // Sidebar Toggle
        const toggleBtn = document.getElementById('sidebarToggleBtn');
        const dashboardLayout = document.getElementById('dashboardLayout');
        if (toggleBtn && dashboardLayout) {
            toggleBtn.addEventListener('click', function () {
                dashboardLayout.classList.toggle('sidebar-collapsed');
                setTimeout(function () { window.dispatchEvent(new Event('resize')); }, 300);
            });
        }

        // Dynamic Cascading Dropdown Logic (Companies -> Customers)
        $('#selectedStation').change(function () {
            var selectedStation = $(this).val();
            var customerDropdown = $('#selectedCustomer');

            customerDropdown.empty();
            customerDropdown.append($('<option></option>').val('').text('-- All Customers --'));

            var isAllSelected = !selectedStation || selectedStation === '-- All Companies --' || selectedStation === '-- All Stations --';

            $.ajax({
                url: '@Url.Action("GetCustomersByStation", "Dashboard")',
                type: 'GET',
                data: { station: isAllSelected ? '' : selectedStation },
                success: function (customers) {
                    if (customers && customers.length > 0) {
                        $.each(customers, function (i, customer) {
                            customerDropdown.append($('<option></option>').val(customer).text(customer));
                        });
                    }
                },
                error: function (xhr, status, error) {
                    console.error("Failed to fetch scoped customers: " + error);
                }
            });
        });

        // ---- Trend charts ----
        const T = @Html.Raw(json);
        const css = getComputedStyle(document.documentElement);
        const token = function (name) { return css.getPropertyValue(name).trim(); };
        const SERIES = [token('--series-1'), token('--series-2'), token('--series-3'), token('--series-4'), token('--series-5')];
        const OTHER = token('--series-other');
        const isMonth = T.Grain === 'month';
        const labels = T.Buckets.map(function (b) { return b.Label; });
        const partial = T.Buckets.map(function (b) { return b.Partial; });
        const MONTHS = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];

        function bucketTitle(i) {
            const p = T.Buckets[i].Start.split('-');
            const text = isMonth ? MONTHS[+p[1] - 1] + ' ' + p[0] : 'Week of ' + p[2] + ' ' + MONTHS[+p[1] - 1] + ' ' + p[0];
            return partial[i] ? text + ' (partial)' : text;
        }

        function money(v) {
            const a = Math.abs(v);
            const s = a >= 1e6 ? (a / 1e6).toFixed(a >= 1e7 ? 1 : 2).replace(/\.?0+$/, '') + 'M'
                : a >= 1e3 ? (a / 1e3).toFixed(a >= 1e4 ? 0 : 1).replace(/\.0$/, '') + 'K'
                : a.toFixed(0);
            return (v < 0 ? '-$' : '$') + s;
        }
        function moneyFull(v) { return (v < 0 ? '-$' : '$') + Math.abs(v).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }); }
        function count(v) { return Math.round(v).toLocaleString('en-US'); }
        function pct(v) { return v == null ? '–' : v.toFixed(1) + '%'; }

        Chart.defaults.font.family = getComputedStyle(document.body).fontFamily;
        Chart.defaults.font.size = 11;
        Chart.defaults.color = token('--chart-ink');

        // Vertical guide line at the hovered point.
        const crosshair = {
            id: 'crosshair',
            afterDatasetsDraw: function (chart) {
                const active = chart.tooltip && chart.tooltip.getActiveElements();
                if (!active || !active.length) return;
                const x = active[0].element.x, area = chart.chartArea, ctx = chart.ctx;
                ctx.save();
                ctx.strokeStyle = token('--chart-ink');
                ctx.globalAlpha = 0.35;
                ctx.lineWidth = 1;
                ctx.beginPath(); ctx.moveTo(x, area.top); ctx.lineTo(x, area.bottom); ctx.stroke();
                ctx.restore();
            }
        };

        function options(format, opts) {
            opts = opts || {};
            return {
                responsive: true,
                maintainAspectRatio: false,
                interaction: { mode: 'index', intersect: false },
                plugins: {
                    legend: {
                        display: opts.legend !== false,
                        position: 'bottom',
                        labels: { usePointStyle: true, pointStyle: 'circle', boxWidth: 8, boxHeight: 8, padding: 14, color: token('--color-text') }
                    },
                    tooltip: {
                        backgroundColor: '#0f1a2b',
                        padding: 10,
                        boxPadding: 4,
                        usePointStyle: true,
                        callbacks: {
                            title: function (items) { return bucketTitle(items[0].dataIndex); },
                            label: function (item) { return ' ' + item.dataset.label + ': ' + (opts.tooltipFormat || format)(item.raw); }
                        }
                    }
                },
                scales: {
                    x: { stacked: !!opts.stacked, grid: { display: false }, border: { color: token('--color-border') } },
                    y: {
                        stacked: !!opts.stacked,
                        beginAtZero: opts.beginAtZero !== false,
                        grid: { color: token('--chart-grid') },
                        border: { display: false },
                        ticks: { callback: function (v) { return format(v); }, maxTicksLimit: 6 }
                    }
                }
            };
        }

        // A line segment touching a partly covered week/month is dashed.
        const partialSegment = {
            borderDash: function (ctx) { return partial[ctx.p0DataIndex] || partial[ctx.p1DataIndex] ? [5, 4] : undefined; }
        };

        function line(label, data, color) {
            return {
                label: label, data: data, borderColor: color, backgroundColor: color,
                borderWidth: 2, pointRadius: 4, pointHoverRadius: 6,
                pointBackgroundColor: color, pointBorderColor: '#ffffff', pointBorderWidth: 2,
                segment: partialSegment, spanGaps: true
            };
        }

        const charts = {};

        charts.moneyChart = new Chart(document.getElementById('moneyChart'), {
            type: 'line',
            data: {
                labels: labels,
                datasets: [
                    line('Revenue', T.Revenue, SERIES[0]),
                    line('Cost', T.Cost, SERIES[1]),
                    line('Gross profit', T.GrossProfit, SERIES[2])
                ]
            },
            options: options(money, { tooltipFormat: moneyFull }),
            plugins: [crosshair]
        });

        charts.marginChart = new Chart(document.getElementById('marginChart'), {
            type: 'line',
            data: { labels: labels, datasets: [line('Gross margin', T.MarginPct, SERIES[0])] },
            options: options(function (v) { return v == null ? '–' : (+v).toFixed(0) + '%'; }, { legend: false, beginAtZero: false, tooltipFormat: pct }),
            plugins: [crosshair]
        });

        const TYPE_COLORS = { Import: SERIES[0], Export: SERIES[1], Domestic: SERIES[2], Other: OTHER };
        charts.shipmentsChart = new Chart(document.getElementById('shipmentsChart'), {
            type: 'bar',
            data: {
                labels: labels,
                datasets: T.ShipmentsByType.map(function (s) {
                    const color = TYPE_COLORS[s.Name] || OTHER;
                    return {
                        label: s.Name, data: s.Values,
                        backgroundColor: s.Values.map(function (v, i) { return partial[i] ? color + '66' : color; }),
                        borderColor: '#ffffff', borderWidth: { top: 2, right: 0, bottom: 0, left: 0 }, borderSkipped: false,
                        maxBarThickness: 32
                    };
                })
            },
            options: options(count, { stacked: true }),
            plugins: [crosshair]
        });

        // Company colors follow the company, not its rank, so filtering never repaints a line.
        const FIXED_COMPANY = { 'Gillespie-Munro Canada': SERIES[0], 'Gillship Navigation': SERIES[1], 'Gillespie-Munro USA': SERIES[2] };
        let spare = 3;
        charts.companyChart = new Chart(document.getElementById('companyChart'), {
            type: 'line',
            data: {
                labels: labels,
                datasets: T.CompanyGrossProfit.map(function (s) {
                    const color = s.Name === 'Other' ? OTHER : (FIXED_COMPANY[s.Name] || SERIES[Math.min(spare++, SERIES.length - 1)]);
                    return line(s.Name, s.Values, color);
                })
            },
            options: options(money, { tooltipFormat: moneyFull, beginAtZero: false }),
            plugins: [crosshair]
        });

        // Table view for each chart: one row per week/month, one column per series.
        const FORMATS = { moneyChart: moneyFull, marginChart: pct, shipmentsChart: count, companyChart: moneyFull };
        document.querySelectorAll('[data-chart-panel]').forEach(function (panel) {
            const canvas = panel.querySelector('canvas');
            const wrap = panel.querySelector('.chart-wrap');
            const tableWrap = panel.querySelector('[data-chart-table]');
            const btn = panel.querySelector('[data-view-toggle]');
            btn.addEventListener('click', function () {
                const showTable = tableWrap.hidden;
                if (showTable && !tableWrap.innerHTML) {
                    const chart = charts[canvas.id], fmt = FORMATS[canvas.id];
                    let html = '<table class="data-table"><thead><tr><th>' + (isMonth ? 'Month' : 'Week of') + '</th>';
                    chart.data.datasets.forEach(function (d) { html += '<th class="num">' + $('<div>').text(d.label).html() + '</th>'; });
                    html += '</tr></thead><tbody>';
                    chart.data.labels.forEach(function (l, i) {
                        html += '<tr><td>' + bucketTitle(i) + '</td>';
                        chart.data.datasets.forEach(function (d) { html += '<td class="num">' + fmt(d.data[i]) + '</td>'; });
                        html += '</tr>';
                    });
                    tableWrap.innerHTML = html + '</tbody></table>';
                }
                tableWrap.hidden = !showTable;
                wrap.hidden = showTable;
                btn.textContent = showTable ? 'Chart' : 'Table';
            });
        });

        // Tabs. The tables are set up the first time their tab opens, so DataTables can size them.
        const tables = {};
        function showTab(which) {
            const business = which === 'business';
            document.getElementById('tabBusiness').hidden = !business;
            document.getElementById('tabCustomers').hidden = business;
            document.getElementById('tabBtnBusiness').setAttribute('aria-selected', business);
            document.getElementById('tabBtnCustomers').setAttribute('aria-selected', !business);
            if (!business && !tables.customerTable) {
                ['customerTable', 'salesTable'].forEach(function (id) {
                    tables[id] = $('#' + id).DataTable({ pageLength: 10, orderCellsTop: true, dom: '<"dt-top"lf><"table-scroll"t><"dt-bottom"ip>', order: [[2, 'desc']], columnDefs: [{ targets: -1, orderable: false }] });
                });
            }
            try { localStorage.setItem('trendsTab', which); } catch (e) { }
        }
        document.getElementById('tabBtnBusiness').addEventListener('click', function () { showTab('business'); });
        document.getElementById('tabBtnCustomers').addEventListener('click', function () { showTab('customers'); });
        document.querySelectorAll('[data-sort-table]').forEach(function (btn) {
            btn.addEventListener('click', function () {
                tables[btn.getAttribute('data-sort-table').slice(1)].order([3, btn.getAttribute('data-sort-dir')]).draw();
            });
        });
        let savedTab = null;
        try { savedTab = localStorage.getItem('trendsTab'); } catch (e) { }
        if (savedTab === 'customers') showTab('customers');
    });
    </script>
    <script>
        // Carry the current filters (query string) across the sidebar module links.
        document.querySelectorAll('.nav-group .nav-link').forEach(function (a) { a.search = window.location.search; });
    </script>
</body>
</html>
